#!/bin/sh
# xiaoliulab-docs lastUpdated hook
while read -r local_ref local_sha remote_ref remote_sha
do
  case "$local_sha" in 0000000000000000000000000000000000000000) continue ;; esac
  case "$remote_sha" in 0000000000000000000000000000000000000000) remote_sha=EMPTY ;; esac
  node scripts/check-last-updated.mjs --base "$remote_sha" --head "$local_sha" --range || exit 1
done
